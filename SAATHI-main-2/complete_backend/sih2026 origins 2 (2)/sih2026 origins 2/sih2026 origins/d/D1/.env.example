# SAATHI D1 Conversational Chat Interface Configuration
PORT=5001
NODE_ENV=development

# Database (PostgreSQL with pgvector support)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=saathi_db
DB_SCHEMA=public
DB_SSL=false
DB_SYNCHRONIZE=false

# M5 FastAPI RAG Engine Endpoint
RAG_SERVICE_URL=http://localhost:8000
RAG_API_KEY=

# Throttling / Rate Limiting (P1)
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# JWT Auth Secret
JWT_SECRET=supersecretjwtkey_change_in_production
