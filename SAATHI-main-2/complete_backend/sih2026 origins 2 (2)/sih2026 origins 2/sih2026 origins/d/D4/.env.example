# Postgres connection string. Used by both the running app (loaded via
# ConfigModule) and the TypeORM CLI (loaded via data-source.ts).
DATABASE_URL=postgresql://saathi:saathi@localhost:5432/saathi_dev

# Set to "true" only when connecting to a Postgres instance that
# requires TLS with a self-signed / managed certificate (most managed
# cloud Postgres offerings). Leave unset or "false" for local Docker
# Postgres — enabling this against a plain local instance will just
# make the connection fail.
PGSSL=false

# Port this service listens on. D3 (citation viewer) defaults to 5003;
# D4 defaults to 5004 so both can run side by side on one machine.
PORT=5004

# Hard cap on how many messages GET /conversations/:id/resume will
# ever return in one response, even for a conversation that's grown
# huge. Read fresh on every request — see
# ConversationsService.maxResumeMessages's doc comment for exactly why
# this can't be a module-level constant like the pagination `limit`
# bounds are.
MAX_RESUME_MESSAGES=2000
