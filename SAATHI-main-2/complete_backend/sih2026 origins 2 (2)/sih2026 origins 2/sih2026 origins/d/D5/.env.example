# ---- App ----
PORT=3001
NODE_ENV=development

# ---- Postgres ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=saathi
DB_PASSWORD=saathi
DB_DATABASE=saathi_d5

# ---- Redis / BullMQ (ingestion queue) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Auth ----
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=8h

# ---- Storage ----
# "local" for dev/demo, "s3" for prod
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=saathi-source-documents
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Internal service-to-service auth ----
# Shared secret the M1 ingestion/FastAPI RAG service presents when
# reporting job-status updates back to D5 (see internal-ingestion.controller.ts)
INTERNAL_SERVICE_API_KEY=change-me-internal-key

# ---- Demo/dev only ----
# Simulates M1's ingestion pipeline finishing jobs so the D5 flow is
# demonstrable end-to-end without the real FastAPI service running.
# NEVER enable in production.
ENABLE_MOCK_INGESTION_WORKER=true
