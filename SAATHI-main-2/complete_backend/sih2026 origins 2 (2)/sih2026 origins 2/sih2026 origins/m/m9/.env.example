# ==============================================================================
# SAATHI BIS Assistant - Module M9 (Session Management & SSE Gateway) Config
# ==============================================================================

# Application Port
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bis_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bis_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Downstream Microservice URLs
M3_RETRIEVAL_URL=http://localhost:8003/api/v1/retrieval
M5_GENERATION_URL=http://localhost:8005/api/v1/generate

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
