# ==============================================================================
# SAATHI BIS Assistant - Module M3 (Vector Search & Semantic Retrieval) Config
# ==============================================================================

# Application Settings
APP_NAME=SAATHI-M3-Vector-Retrieval
APP_ENV=development
DEBUG=True
PORT=8003
HOST=0.0.0.0

# Database Configuration (PostgreSQL with pgvector & tsvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bis_db
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_TIMEOUT=30.0

# Retrieval & Ranking Parameters
EMBEDDING_DIM=1536
RRF_K=60
DEFAULT_TOP_K=10
MAX_TOP_K=100
EXACT_IS_BOOST_SCORE=0.05
