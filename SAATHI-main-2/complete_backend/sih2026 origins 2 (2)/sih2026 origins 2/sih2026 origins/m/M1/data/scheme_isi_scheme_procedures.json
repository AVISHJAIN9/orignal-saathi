0\u0906\u0908\u090f\u0938 \u0939\u0949\u0932\u092e\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f \u0905\u0927\u093f\u0915\u0924\u0930 \u092a\u0942\u091b\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 \u00bb \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u092c\u0940\u0906\u0908\u090f\u0938 \u0905\u0927\u093f\u0928\u093f\u092f\u092e \u0914\u0930 \u0935\u093f\u0928\u093f\u092f\u092e\u0928 \" target=\"_blank\" >\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0909\u092a\u092d\u094b\u0915\u094d\u0924\u093e --> \u0939\u092e\u0947\u0902 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0902 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0938\u093f\u0902\u0939\u093e\u0935\u0932\u094b\u0915\u0928 \u0906\u0935\u0947\u0926\u0928 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0906\u0908\u091f\u0940\u092a\u0940 \u092a\u0942\u0930\u094d\u0935 \u092a\u094b\u0930\u094d\u091f\u0932 \u0906\u0908\u091f\u0940\u0908\u0938\u0940 \u0915\u0947 \u0924\u0939\u0924 \u0906\u0908\u091f\u0940\u092a\u0940 \u0936\u0941\u0932\u094d\u0915 \u092a\u094d\u0930\u092a\u0924\u094d\u0930 \u0905\u0927\u093f\u0915\u0924\u0930 \u092a\u0942\u091b\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 \u0939\u092e\u0947\u0902 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0902 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u092a\u094b\u0930\u094d\u091f\u0932 NITS \u091f\u094d\u0930\u0947\u0928\u093f\u0902\u0917 \u092a\u0930 BIS \u0915\u094d\u0935\u093e\u0932\u093f\u091f\u0940 \u091f\u0949\u0