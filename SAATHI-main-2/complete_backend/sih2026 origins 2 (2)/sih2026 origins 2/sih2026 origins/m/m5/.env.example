# ==============================================================================
# SAATHI BIS Assistant - Module M5 (RAG Generation & Quality Engine) Config
# ==============================================================================

# Application Settings
APP_NAME=SAATHI-M5-RAG-Generation
APP_ENV=development
DEBUG=True
PORT=8005
HOST=0.0.0.0
API_V1_PREFIX=/api/v1/generate

# LLM Configuration (OpenAI / Azure / Custom Provider)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# Hallucination Guardrails & Cite-or-Decline Quality Thresholds
CONFIDENCE_THRESHOLD=0.70
MIN_CONTEXT_CHUNKS=1
ENABLE_STRICT_CITE_OR_DECLINE=True

# Prompt & Persona Settings
DEFAULT_PROMPT_TEMPLATE=standard_qa
DEFAULT_USER_LANGUAGE=en
