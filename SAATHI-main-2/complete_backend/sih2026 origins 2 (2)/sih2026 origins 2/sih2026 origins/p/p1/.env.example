# ==============================================================================
# SAATHI BIS Assistant - Module P1 (Authentication & Rate Limiting) Config
# ==============================================================================

# Application Configuration
APP_NAME=SAATHI-P1-Auth-RateLimiting
APP_ENV=development
PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=*

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bis_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis Configuration (for Distributed Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Global Rate Limiting (Default: 10 requests per minute)
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Endpoint Specific Rate Limits
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=5
THROTTLE_ANON_TTL=60
THROTTLE_ANON_LIMIT=20

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_saathi_bis_platform_change_in_production
JWT_EXPIRES_IN=7d
JWT_ANON_EXPIRES_IN=24h
