# ==============================================================================
# SAATHI BIS Assistant - Module P3 (LLM Cost & Usage Monitoring) Config
# ==============================================================================

# Application Configuration
APP_NAME=SAATHI-P3-LLM-Telemetry
NODE_ENV=development
PORT=8003
HOST=0.0.0.0
CORS_ORIGINS=*

# PostgreSQL Database Configuration
# Uses synchronize: false — table must be created via migration or manually
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bis_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bis_db
DB_LOGGING=false

# LLM Cost Model Pricing (USD per 1 million tokens)
# These override the built-in defaults if set.
# gpt-4o-mini defaults: input=$0.15, output=$0.60
COST_GPT4O_MINI_INPUT=0.15
COST_GPT4O_MINI_OUTPUT=0.60
# gpt-4o defaults: input=$5.00, output=$15.00
COST_GPT4O_INPUT=5.00
COST_GPT4O_OUTPUT=15.00
# gpt-3.5-turbo defaults: input=$0.50, output=$1.50
COST_GPT35_TURBO_INPUT=0.50
COST_GPT35_TURBO_OUTPUT=1.50
