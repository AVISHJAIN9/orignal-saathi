# ==============================================================================
# SAATHI BIS Assistant - Module P4 (System Health & Ops API) Config
# ==============================================================================

# Application Configuration
APP_NAME=SAATHI-P4-Health-Ops
NODE_ENV=development
PORT=8004
HOST=0.0.0.0
CORS_ORIGINS=*

# PostgreSQL Database Configuration (shared bis_db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bis_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bis_db
DB_LOGGING=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Health Check Thresholds
# Time in hours after which the vector index is considered "stale"
VECTOR_STALENESS_THRESHOLD_HOURS=24

# Downstream service URLs to probe for connectivity
M3_RETRIEVAL_URL=http://localhost:8003/api/v1/retrieval
M5_GENERATION_URL=http://localhost:8005/api/v1/generate
M9_SESSION_URL=http://localhost:3000/api/v1
