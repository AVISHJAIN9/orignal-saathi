# ==============================================================================
# SAATHI BIS Assistant - Module P2 (Data Retention & Privacy Controls) Config
# ==============================================================================

# Application Configuration
APP_NAME=SAATHI-P2-Data-Retention
NODE_ENV=development
PORT=8002
HOST=0.0.0.0
CORS_ORIGINS=*

# Retention & Privacy Policy Configuration
# RETENTION_DAYS: Age threshold in days after which conversations/messages are purged
RETENTION_DAYS=90

# CRON_SCHEDULE: Standard 5-field cron expression
# Default: '0 0 * * *' (Nightly at midnight 00:00:00 UTC)
# For every minute testing: '* * * * *'
CRON_SCHEDULE=0 0 * * *

# Enable or disable automatic cron execution (true/false)
RETENTION_CRON_ENABLED=true

# PostgreSQL Database Configuration (Matches M9 Session DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bis_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bis_db
DB_LOGGING=false
