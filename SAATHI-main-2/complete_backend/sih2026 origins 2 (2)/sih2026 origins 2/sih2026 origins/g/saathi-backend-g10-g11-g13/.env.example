# --- G10: CAPTCHA ---
# Pick one provider and set CAPTCHA_PROVIDER to match. Default is reCAPTCHA v3.
CAPTCHA_PROVIDER=recaptcha_v3
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5
# Only needed if CAPTCHA_PROVIDER=hcaptcha
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SITE_KEY=
# Only affects provider-unreachable/timeout failures — never overrides a
# genuine negative verdict (low score, action mismatch). Leave false unless
# you've deliberately decided availability beats bot-blocking during an
# outage.
CAPTCHA_FAIL_OPEN=false

# --- G11: 2FA ---
# No new env vars — TOTP secrets are generated per-user and stored via
# TwoFactorPort (P1's credentials table once wired in).

# --- G13: Sitemap ---
# Used to build absolute <loc> URLs. Should match the same value used by
# G4's reset-link building, if this backend already defines it elsewhere —
# don't duplicate the var, just reuse APP_BASE_URL.
APP_BASE_URL=https://saathi.example.gov.in
