# --- Postgres (shared with the rest of the NestJS backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=saathi
DB_PASSWORD=changeme
DB_NAME=saathi

# --- Redis (shared with M1's BullMQ ingestion queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- SMTP (G5 email engine) ---
# Point at SES SMTP, SendGrid SMTP, or Mailtrap for local/dev testing.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@saathi.example.gov.in

# --- G4 password reset ---
# Used to build the reset link emailed to the user; must match wherever
# the frontend's /reset-password route is actually hosted.
APP_BASE_URL=https://saathi.example.gov.in

# --- Auth (consumed by JwtAuthGuard, owned by P1) ---
JWT_SECRET=changeme-use-a-real-secret
